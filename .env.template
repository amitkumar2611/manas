# MANAS configuration — copy to .env; every default works offline (local-first)
MANAS_PROVIDER=echo            # echo | anthropic | copilot | ollama
MANAS_MODEL=                   # provider-specific model id (blank = adapter default)
MANAS_ANTHROPIC_API_KEY=
MANAS_GITHUB_COM_TOKEN=        # Copilot API (same convention as ATIQ)
MANAS_OLLAMA_URL=http://localhost:11434
MANAS_APPROVAL_MODE=ask        # ask | deny  (there is deliberately no "auto")
MANAS_MEMORY_BACKEND=sqlite   # sqlite (Phase 2) | jsonl (Phase 1 legacy)
MANAS_EMBEDDER=hash           # hash (offline, zero-dep) | ollama (real embeddings)
MANAS_EMBED_MODEL=nomic-embed-text
MANAS_LOG_LEVEL=INFO

# -- Phase 5 integrations (leave blank to disable a tool) --
MANAS_GITHUB_API=https://api.github.com   # GHE: https://github.hpe.com/api/v3
MANAS_GITHUB_TOKEN=                       # Enterprise/PR reads (ATIQ convention)
MANAS_JIRA_URL=
MANAS_JIRA_EMAIL=
MANAS_JIRA_TOKEN=
MANAS_TESTRAIL_URL=
MANAS_TESTRAIL_USER=
MANAS_TESTRAIL_KEY=
MANAS_SLACK_WEBHOOK=
MANAS_SMTP_HOST=
MANAS_SMTP_FROM=
